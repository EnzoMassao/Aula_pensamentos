#include <Servo.h>

int botao = 0;

int temp = 0;

int graus = 0;

Servo servo_6;

void setup()
{
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);
  servo_6.attach(6, 500, 2500);
  pinMode(5, INPUT);
  Serial.begin(9600);
  pinMode(A0, INPUT);
  pinMode(A1, INPUT);

  digitalWrite(2, HIGH);
  digitalWrite(3, LOW);
  digitalWrite(4, LOW);
  servo_6.write(0);
}

void loop()
{
  botao = digitalRead(5);
  Serial.println(botao);
  if (botao == 1) {
    digitalWrite(2, LOW);
    digitalWrite(3, HIGH);
    graus = map(analogRead(A0), 0, 1023, 0, 180);
    temp = map(analogRead(A1), 0, 1023, 1, 10);
    servo_6.write(graus);
    delay(1000 * temp); // Wait for 1000 * temp millisecond(s)
    servo_6.write(0);
    digitalWrite(3, LOW);
    digitalWrite(4, HIGH);
    delay(2000); // Wait for 2000 millisecond(s)
    digitalWrite(2, HIGH);
    digitalWrite(4, LOW);
  }
}
